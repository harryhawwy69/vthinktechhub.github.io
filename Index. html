const PALETTE=["#132447","#2F5DA8","#B5651D","#2E7D5B","#7A3E8E","#A23B48","#1F6F78"];
const esc=s=>String(s??"").replace(/[&<>"]/g,c=>({"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;"}[c]));
const initials=n=>String(n||"?").split(/\s+/).filter(Boolean).slice(0,2).map(w=>w.replace(/[^A-Za-z]/g,"")[0]||"").join("").toUpperCase()||"?";
const hue=n=>PALETTE[[...String(n)].reduce((a,c)=>a+c.charCodeAt(0),0)%PALETTE.length];
function mark(cls,name,img){
  if(img) return `<div class="${cls}" data-initials="${esc(initials(name))}" data-bg="${hue(name)}"><img src="${esc(img)}" alt="${esc(name)}"></div>`;
  return `<div class="${cls}" style="background:${hue(name)}" aria-hidden="true">${esc(initials(name))}</div>`;
}
function guardImages(){
  document.querySelectorAll("[data-initials] img").forEach(img=>{
    const swap=()=>{const b=img.parentElement;b.style.background=b.dataset.bg;b.textContent=b.dataset.initials;};
    img.addEventListener("error",swap,{once:true});
    if(img.complete&&img.naturalWidth===0) swap();
  });
}
function safe(fn,id){try{fn();}catch(e){const el=id&&document.getElementById(id);if(el)el.innerHTML='<p class="pending">This section could not load. Please refresh the page.</p>';}}
STARTUPS.forEach((s,i)=>{s.sno=s.sno||`VT-${String(i+1).padStart(3,"0")}`;s.founders=Array.isArray(s.founders)?s.founders.filter(f=>f&&f.name):[];s.stage=s.stage||"Ideation";s.domain=s.domain||"Other";});

let active="All";
function renderFilters(){
  const ds=[...new Set(STARTUPS.map(s=>s.domain))];
  const all=["All",...ds];
  document.getElementById("filters").innerHTML=all.length<3?"":all.map((d,i)=>`<button class="filter" type="button" id="f${i}" aria-pressed="${d===active}" data-d="${esc(d)}">${esc(d)}</button>`).join("");
  document.querySelectorAll(".filter").forEach(b=>b.addEventListener("click",()=>{active=b.dataset.d;safe(renderFilters,"filters");safe(renderGrid,"grid");safe(guardImages);}));
}
function renderGrid(){
  const list=STARTUPS.filter(s=>active==="All"||s.domain===active);
  document.getElementById("grid").innerHTML=list.map(s=>`
    <article class="venture">
      <div class="vhead">${mark("logo",s.name,s.logo)}<div><div class="sno">${esc(s.sno)}</div><h3>${esc(s.name)}</h3><div class="tagline">${esc(s.tagline)}</div></div></div>
      <p class="pitch">${esc(s.pitch)}</p>
      <div class="chips"><span class="chip">${esc(s.domain)}</span><span class="chip">Stage: ${esc(s.stage)}</span></div>
      <div class="founders">${s.founders.length?s.founders.map(f=>`<div class="fd">${mark("fav",f.name,f.photo)}<div class="fdt"><b>${esc(f.name)}</b><small>${esc(f.role)}</small></div>${f.linkedin?`<a class="fli" href="${esc(f.linkedin)}" target="_blank" rel="noopener" aria-label="${esc(f.name)} on LinkedIn">${LI}</a>`:""}</div>`).join(""):'<span class="pending">Founding team to be announced</span>'}</div>
    </article>`).join("");
}
function renderLadder(){
  document.getElementById("ladder").innerHTML=STAGES.map((st,i)=>{
    const n=STARTUPS.filter(s=>s.stage===st.key).length;
    return `<div class="rung ${n?"on":""}"><div class="step">Stage ${i+1}</div><h3>${st.title}</h3><p>${st.text}</p><div class="count">${n?`${n} startup${n>1?"s":""} here now`:"Next milestone"}</div></div>`;
  }).join("");
}
const LI='<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M20.45 20.45h-3.56v-5.57c0-1.33-.02-3.04-1.85-3.04-1.85 0-2.14 1.45-2.14 2.94v5.67H9.34V9h3.42v1.56h.05c.48-.9 1.64-1.85 3.37-1.85 3.6 0 4.27 2.37 4.27 5.46v6.28zM5.34 7.43a2.06 2.06 0 1 1 0-4.13 2.06 2.06 0 0 1 0 4.13zM7.12 20.45H3.56V9h3.56v11.45zM22.22 0H1.77C.8 0 0 .77 0 1.73v20.54C0 23.23.8 24 1.77 24h20.45c.98 0 1.78-.77 1.78-1.73V1.73C24 .77 23.2 0 22.22 0z"/></svg>';
function renderTeam(){
  const li='<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M20.45 20.45h-3.56v-5.57c0-1.33-.02-3.04-1.85-3.04-1.85 0-2.14 1.45-2.14 2.94v5.67H9.34V9h3.42v1.56h.05c.48-.9 1.64-1.85 3.37-1.85 3.6 0 4.27 2.37 4.27 5.46v6.28zM5.34 7.43a2.06 2.06 0 1 1 0-4.13 2.06 2.06 0 0 1 0 4.13zM7.12 20.45H3.56V9h3.56v11.45zM22.22 0H1.77C.8 0 0 .77 0 1.73v20.54C0 23.23.8 24 1.77 24h20.45c.98 0 1.78-.77 1.78-1.73V1.73C24 .77 23.2 0 22.22 0z"/></svg>';
  document.getElementById("teamgrid").innerHTML=TEAM.map(p=>`
    <article class="person">${mark("avatar",p.name,p.photo)}
      <div><h3>${esc(p.name)}</h3><div class="r">${esc(p.role)}</div><p>${esc(p.bio)}</p>
      ${p.linkedin?`<a class="li" href="${esc(p.linkedin)}" target="_blank" rel="noopener">${li}LinkedIn</a>`:""}</div>
    </article>`).join("");
}
function renderStats(){
  document.getElementById("st-startups").textContent=STARTUPS.length;
  document.getElementById("st-founders").textContent=new Set(STARTUPS.flatMap(s=>s.founders.map(f=>f.name))).size;
  document.getElementById("st-domains").textContent=new Set(STARTUPS.map(s=>s.domain)).size;
}
safe(renderStats);safe(renderLadder,"ladder");safe(renderFilters,"filters");safe(renderGrid,"grid");safe(renderTeam,"teamgrid");safe(guardImages);
</script>
</body>
</html>
