<style>
/* Layout idea: university-hub information architecture. Ink masthead with impact numbers, numbered offer list, stage ladder, cohort directory, mentor roles with time, matching steps, leadership, contact. */
:root{
  --ink:#132447; --gold:#E39B12; --gold-text:#9A6600; --paper:#F6F7FA; --card:#FFFFFF;
  --text:#18203A; --muted:#5B6480; --line:#DDE1EB; --chip:#EEF1F7; --on-ink:#F4F6FB;
  --display:"Bricolage Grotesque","Segoe UI",system-ui,sans-serif;
  --body:"IBM Plex Sans","Segoe UI",system-ui,sans-serif;
  --mono:"IBM Plex Mono",ui-monospace,Menlo,monospace;
  color-scheme:light;
}
*{box-sizing:border-box}
html{scroll-behavior:smooth}
html,body{margin:0}
body{background:var(--paper);color:var(--text);font:16px/1.6 var(--body);-webkit-font-smoothing:antialiased}
a{color:inherit}
img{max-width:100%;display:block}
h1,h2,h3{font-family:var(--display);line-height:1.12;margin:0;text-wrap:balance}
.wrap{max-width:1120px;margin:0 auto;padding:0 20px}
:focus-visible{outline:3px solid var(--gold);outline-offset:3px;border-radius:4px}
@media (prefers-reduced-motion: reduce){html{scroll-behavior:auto}}

/* Header */
header.top{background:var(--ink);color:var(--on-ink);position:sticky;top:0;z-index:10}
.bar{display:flex;align-items:center;justify-content:space-between;gap:16px;padding-top:12px;padding-bottom:12px}
.brand{display:flex;align-items:center;gap:10px;text-decoration:none;font-family:var(--display);font-weight:800;font-size:1.12rem;letter-spacing:-.01em;white-space:nowrap}
.brand svg{width:34px;height:34px;flex:none}
.brand .v{color:var(--gold)}
.navlinks{display:flex;gap:20px;font-size:.92rem;overflow-x:auto;scrollbar-width:none}
.navlinks::-webkit-scrollbar{display:none}
.navlinks a{text-decoration:none;opacity:.85;white-space:nowrap;padding:6px 0}
.navlinks a:hover{opacity:1}
.navcta{background:var(--gold);color:#1A1405;text-decoration:none;font-weight:600;font-size:.88rem;padding:8px 14px;border-radius:8px;white-space:nowrap}
@media (max-width:820px){
  .bar{flex-wrap:wrap;row-gap:4px}
  .navlinks{order:3;width:100%;gap:18px;padding-bottom:4px}
}

/* Hero */
.hero{background:var(--ink);color:var(--on-ink);padding:40px 0 0}
.eyebrow{font-family:var(--mono);font-size:.76rem;letter-spacing:.09em;text-transform:uppercase;color:var(--gold)}
.hero h1{font-size:clamp(2.1rem,5vw,3.6rem);font-weight:800;letter-spacing:-.025em;margin:14px 0 0;max-width:18ch}
.hero .lead{max-width:60ch;font-size:1.08rem;opacity:.9;margin:18px 0 0}
.founded{margin:14px 0 0;font-size:.95rem;opacity:.92}
.founded b{color:var(--gold);font-weight:600}
.btns{display:flex;gap:12px;flex-wrap:wrap;margin-top:26px}
.btn{display:inline-flex;align-items:center;padding:12px 20px;border-radius:10px;font-weight:600;text-decoration:none;font-size:.97rem;border:1.5px solid transparent}
.btn.primary{background:var(--gold);color:#1A1405}
.btn.ghost{border-color:rgba(244,246,251,.4);color:var(--on-ink)}
.btn.dark{background:var(--ink);color:var(--on-ink)}
.stats{display:grid;grid-template-columns:repeat(4,1fr);margin-top:40px;border-top:1px solid rgba(244,246,251,.18)}
.stat{padding:18px 12px 22px 0}
.stat b{display:block;font-family:var(--display);font-size:2.3rem;font-weight:800;color:var(--gold);line-height:1.05;font-variant-numeric:tabular-nums}
.stat span{font-size:.85rem;opacity:.82}
@media (max-width:640px){.stats{grid-template-columns:repeat(2,1fr)}}

/* Sections */
section{padding:72px 0 0}
.kicker{font-family:var(--mono);font-size:.74rem;letter-spacing:.09em;text-transform:uppercase;color:var(--gold-text);margin-bottom:10px}
.sechead h2{font-size:clamp(1.7rem,3.4vw,2.4rem);font-weight:800;letter-spacing:-.02em}
.sechead p{color:var(--muted);max-width:62ch;margin:10px 0 0}
.sechead{margin-bottom:30px}

/* 01/02/03 offer list */
.offer{display:grid;grid-template-columns:repeat(3,1fr);gap:0;border-top:2px solid var(--ink)}
.offer div{padding:22px 24px 8px 0}
.offer .n{font-family:var(--mono);color:var(--gold-text);font-size:.9rem}
.offer h3{font-size:1.25rem;margin:6px 0 6px}
.offer p{margin:0;color:var(--muted);font-size:.95rem}
@media (max-width:760px){.offer{grid-template-columns:1fr}.offer div{padding:18px 0 4px;border-bottom:1px solid var(--line)}}

/* Stage ladder */
.ladder{display:grid;grid-template-columns:repeat(4,1fr);gap:12px}
.rung{background:var(--card);border:1px solid var(--line);border-radius:14px;padding:18px;position:relative}
.rung .step{font-family:var(--mono);font-size:.75rem;color:var(--muted)}
.rung h3{font-size:1.1rem;margin:4px 0 6px}
.rung p{margin:0;font-size:.88rem;color:var(--muted)}
.rung .count{margin-top:12px;font-size:.82rem;font-weight:600}
.rung.on{border-color:var(--gold);box-shadow:0 0 0 1px var(--gold) inset}
.rung.on .count{color:var(--gold-text)}
@media (max-width:760px){.ladder{grid-template-columns:1fr 1fr}}

/* Directory */
.dirbar{display:flex;justify-content:space-between;align-items:end;gap:16px;flex-wrap:wrap;margin-bottom:18px}
.filters{display:flex;gap:8px;flex-wrap:wrap}
.filter{font:500 .85rem var(--body);padding:7px 14px;border-radius:999px;border:1px solid var(--line);background:var(--card);color:var(--text);cursor:pointer;min-height:36px}
.filter[aria-pressed="true"]{background:var(--ink);color:var(--on-ink);border-color:var(--ink)}
.grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(310px,1fr));gap:18px}
.venture{background:var(--card);border:1px solid var(--line);border-radius:16px;padding:22px;display:flex;flex-direction:column;gap:14px}
.vhead{display:flex;gap:14px;align-items:center}
.logo{width:60px;height:60px;border-radius:14px;flex:none;display:grid;place-items:center;font-family:var(--display);font-weight:800;font-size:1.2rem;color:#fff;overflow:hidden;background:#fff}
.logo img{width:100%;height:100%;object-fit:contain}
.sno{font-family:var(--mono);font-size:.78rem;color:var(--muted)}
.venture h3{font-size:1.25rem}
.tagline{font-size:.86rem;font-weight:600;color:var(--gold-text)}
.pitch{margin:0;color:var(--muted);font-size:.93rem}
.chips{display:flex;gap:6px;flex-wrap:wrap}
.chip{font-size:.78rem;font-weight:500;padding:3px 10px;border-radius:999px;background:var(--chip)}
.founders{border-top:1px solid var(--line);padding-top:14px;display:flex;flex-direction:column;gap:10px;margin-top:auto}
.fd{display:flex;align-items:center;gap:10px;line-height:1.3;font-size:.92rem}
.fd b{font-weight:600;display:block}
.fd small{color:var(--muted);font-size:.78rem}
.fav{width:40px;height:40px;flex:none;border-radius:50%;overflow:hidden;display:grid;place-items:center;color:#fff;font-weight:700;font-size:.85rem}
.fav img{width:100%;height:100%;object-fit:cover}
.fdt{flex:1;min-width:0}
.fli{flex:none;width:36px;height:36px;display:grid;place-items:center;border-radius:8px;border:1px solid var(--line)}
.fli svg{width:16px;height:16px;fill:#0A66C2}
.fli:hover{background:var(--chip)}
.pending{color:var(--muted);font-style:italic;font-size:.9rem}

/* Mentor roles */
.roles{display:grid;grid-template-columns:repeat(2,1fr);gap:16px}
.role{background:var(--card);border:1px solid var(--line);border-radius:16px;padding:22px;display:flex;flex-direction:column;gap:8px}
.role h3{font-size:1.15rem}
.role p{margin:0;color:var(--muted);font-size:.93rem}
.time{display:inline-flex;align-self:flex-start;gap:6px;align-items:center;font-size:.8rem;font-weight:600;background:#FDF3DF;color:#6B4700;padding:4px 10px;border-radius:999px}
@media (max-width:700px){.roles{grid-template-columns:1fr}}
.steps{display:grid;grid-template-columns:repeat(3,1fr);gap:16px;margin-top:34px;counter-reset:s}
.stepc{border-top:3px solid var(--gold);padding-top:14px}
.stepc .k{font-family:var(--display);font-weight:800;font-size:1.8rem;color:var(--gold-text);line-height:1}
.stepc h3{font-size:1.05rem;margin:8px 0 4px}
.stepc p{margin:0;color:var(--muted);font-size:.92rem}
@media (max-width:700px){.steps{grid-template-columns:1fr}}
.cta{margin-top:34px;background:var(--ink);color:var(--on-ink);border-radius:18px;padding:30px;display:flex;justify-content:space-between;align-items:center;gap:20px;flex-wrap:wrap}
.cta h3{font-size:1.5rem}
.cta p{margin:6px 0 0;opacity:.85}
.mail{font-family:var(--mono);font-size:.88rem;opacity:.9;display:block;margin-top:8px;word-break:break-all}

/* Leadership */
.team{display:grid;grid-template-columns:repeat(auto-fill,minmax(min(100%,440px),1fr));gap:18px}
.person{background:var(--card);border:1px solid var(--line);border-radius:16px;padding:22px;display:flex;gap:16px;align-items:flex-start}
.avatar{width:72px;height:72px;border-radius:50%;flex:none;display:grid;place-items:center;font-family:var(--display);font-weight:800;font-size:1.4rem;color:#fff;overflow:hidden}
.avatar img{width:100%;height:100%;object-fit:cover}
.person h3{font-size:1.1rem}
.person .r{color:var(--gold-text);font-weight:600;font-size:.86rem}
.person p{margin:6px 0 0;color:var(--muted);font-size:.9rem}
.li{display:inline-flex;gap:6px;align-items:center;margin-top:8px;font-size:.85rem;font-weight:600;text-decoration:none}
.li svg{width:16px;height:16px;fill:#0A66C2}

/* Contact */
.contact{display:grid;grid-template-columns:repeat(3,1fr);gap:16px}
.cbox{background:var(--card);border:1px solid var(--line);border-radius:16px;padding:22px}
.cbox .lab{font-size:.75rem;text-transform:uppercase;letter-spacing:.08em;color:var(--muted);font-weight:600}
.cbox .val{margin-top:6px;font-weight:500;word-break:break-word}
.cbox a.go{display:inline-block;margin-top:10px;font-size:.88rem;font-weight:600;color:var(--gold-text)}
@media (max-width:760px){.contact{grid-template-columns:1fr}}

footer{margin-top:80px;background:var(--ink);color:var(--on-ink);padding:32px 0 40px;font-size:.88rem}
footer .wrap{display:flex;justify-content:space-between;gap:16px;flex-wrap:wrap;opacity:.85}
footer b{color:var(--gold);font-weight:600}
</style>
</head>
